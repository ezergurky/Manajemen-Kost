        <mxGraphModel dx="530" dy="1230" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n    class User {\n        &lt;&lt;abstract&gt;&gt;\n        # id : int\n        # nama : String\n        # username : String\n        - email : String\n        - password : String\n        + User(id:int, nama:String, email:String, password:String, username:String)\n        + getId() int\n        + getNama() String\n        + setNama(nama:String) void\n        + getEmail() String\n        + setEmail(email:String) void\n        + getUsername() String\n        + setUsername(username:String) void\n        + getPassword() String\n        + setPassword(password:String) void\n        + logout(frame:JFrame) void\n        + displayDashboard() void\n    }\n\n    class Admin {\n        - role : String\n        + Admin(id:int, nama:String, email:String, password:String, username:String)\n        + getRole() String\n        + setRole(role:String) void\n        + displayDashboard() void\n    }\n\n    class Penghuni {\n        - idPenghuni : int\n        - nik : String\n        - noHp : String\n        + Penghuni(idUser:int, nama:String, email:String, password:String, username:String, idPenghuni:int, nik:String, noHp:String)\n        + getIdPenghuni() int\n        + setIdPenghuni(idPenghuni:int) void\n        + getNik() String\n        + setNik(nik:String) void\n        + getNoHp() String\n        + setNoHp(noHp:String) void\n        + lihatTagihan(dao:TagihanDAO) List~Tagihan~\n        + bayar(tagihan:Tagihan, metodePembayaran:PembayaranService) boolean\n        + displayDashboard() void\n    }\n\n    class Kost {\n        - idKost : int\n        - namaKost : String\n        - alamat : String\n        - fasilitasUtama : String\n        + Kost(idKost:int, namaKost:String, alamat:String, fasilitasUtama:String)\n        + getIdKost() int\n        + setIdKost(idKost:int) void\n        + getNamaKost() String\n        + setNamaKost(namaKost:String) void\n        + getAlamat() String\n        + setAlamat(alamat:String) void\n        + getFasilitasUtama() String\n        + setFasilitasUtama(fasilitasUtama:String) void\n    }\n\n    class Kamar {\n        - idKamar : int\n        - idKost : int\n        - nomorKamar : String\n        - harga : double\n        - fasilitas : String\n        - status : String\n        + Kamar(idKamar:int, idKost:int, nomorKamar:String, harga:double, fasilitas:String, status:String)\n        + getIdKamar() int\n        + setIdKamar(idKamar:int) void\n        + getIdKost() int\n        + setIdKost(idKost:int) void\n        + getNomorKamar() String\n        + setNomorKamar(nomorKamar:String) void\n        + getHarga() double\n        + setHarga(harga:double) void\n        + getFasilitas() String\n        + setFasilitas(fasilitas:String) void\n        + getStatus() String\n        + setStatus(status:String) void\n    }\n\n    class KontrakSewa {\n        - idKontrak : int\n        - idPenghuni : int\n        - idKamar : int\n        - tanggalMulai : Date\n        - tanggalSelesai : Date\n        - status : String\n        + KontrakSewa(idKontrak:int, idPenghuni:int, idKamar:int, tanggalMulai:Date, tanggalSelesai:Date, status:String)\n        + getIdKontrak() int\n        + setIdKontrak(idKontrak:int) void\n        + getIdPenghuni() int\n        + setIdPenghuni(idPenghuni:int) void\n        + getIdKamar() int\n        + setIdKamar(idKamar:int) void\n        + getTanggalMulai() Date\n        + setTanggalMulai(tanggalMulai:Date) void\n        + getTanggalSelesai() Date\n        + setTanggalSelesai(tanggalSelesai:Date) void\n        + getStatus() String\n        + setStatus(status:String) void\n    }\n\n    class Tagihan {\n        - idTagihan : int\n        - idPenghuni : int\n        - bulan : String\n        - tahun : int\n        - jatuhTempo : Date\n        - jumlah : double\n        - denda : double\n        - status : String\n        - penghuni : Penghuni\n        + Tagihan(idTagihan:int, idPenghuni:int, bulan:String, tahun:int, jatuhTempo:Date, jumlah:double, denda:double, status:String)\n        + Tagihan(idTagihan:int, idPenghuni:int, bulan:String, tahun:int, jatuhTempo:Date, jumlah:double, status:String)\n        + hitungTotal() double\n        + hitungTotal(tambahDenda:boolean) double\n        + getIdTagihan() int\n        + getIdPenghuni() int\n        + getBulan() String\n        + getTahun() int\n        + getJatuhTempo() Date\n        + getJumlah() double\n        + getDenda() double\n        + getStatus() String\n        + setStatus(status:String) void\n        + getPenghuni() Penghuni\n        + setPenghuni(penghuni:Penghuni) void\n    }\n\n    class Pembayaran {\n        - idPembayaran : int\n        - idTagihan : int\n        - tanggalBayar : Date\n        - metode : String\n        - jumlahBayar : double\n        - tagihan : Tagihan\n        + Pembayaran(idPembayaran:int, idTagihan:int, tanggalBayar:Date, metode:String, jumlahBayar:double)\n        + getIdPembayaran() int\n        + getIdTagihan() int\n        + getTanggalBayar() Date\n        + getMetode() String\n        + getJumlahBayar() double\n        + getTagihan() Tagihan\n        + setTagihan(tagihan:Tagihan) void\n    }\n\n    class Laporan {\n        - dataPembayaran : List~Pembayaran~\n        + Laporan(dataPembayaran:List~Pembayaran~)\n        + getDataPembayaran() List~Pembayaran~\n        + setDataPembayaran(dataPembayaran:List~Pembayaran~) void\n        + generateLaporanPendapatan(bulan:String, tahun:String) double\n        ~ getTotalTransaksi() int\n        + cetakLogTransaksi() void\n    }\n\n    class PembayaranService {\n        &lt;&lt;interface&gt;&gt;\n        + getNamaMetode() String\n        + hitungTotalBayar(tagihanAwal:double) double\n        + prosesPembayaran(idTagihan:int, tagihanAwal:double) boolean\n    }\n\n    class PembayaranCash {\n        + getNamaMetode() String\n        + hitungTotalBayar(tagihanAwal:double) double\n        + prosesPembayaran(idTagihan:int, tagihanAwal:double) boolean\n    }\n\n    class PembayaranTransfer {\n        + getNamaMetode() String\n        + hitungTotalBayar(tagihanAwal:double) double\n        + prosesPembayaran(idTagihan:int, tagihanAwal:double) boolean\n    }\n\n    %% RELASI PEWARISAN &amp; IMPLEMENTASI (IS-A)\n    User &lt;|-- Admin : Extends\n    User &lt;|-- Penghuni : Extends\n    PembayaranService &lt;|.. PembayaranCash : Implements\n    PembayaranService &lt;|.. PembayaranTransfer : Implements\n\n    %% RELASI OBJEK NYATA DALAM KODE (HAS-A)\n    Laporan \&quot;1\&quot; o-- \&quot;*\&quot; Pembayaran : Aggregation\n    Pembayaran \&quot;*\&quot; --&gt; \&quot;1\&quot; Tagihan : Association \n    Tagihan \&quot;*\&quot; --&gt; \&quot;1\&quot; Penghuni : Association \n\n    %% RELASI LOGIKAL DATABASE (FOREIGN KEY)\n    Kost \&quot;1\&quot; --&gt; \&quot;*\&quot; Kamar\n    Kamar \&quot;1\&quot; --&gt; \&quot;*\&quot; KontrakSewa\n    Penghuni \&quot;1\&quot; --&gt; \&quot;*\&quot; KontrakSewa\n    Penghuni \&quot;1\&quot; --&gt; \&quot;*\&quot; Tagihan&quot;&#xa;}" id="2">
